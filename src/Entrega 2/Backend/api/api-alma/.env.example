# ============================================
# INSTITUTO ALMA BACKEND - CONFIGURAÇÃO
# ============================================

# 🎯 AMBIENTE
NODE_ENV=production
PORT=10000
FRONTEND_URL=https://seu-frontend.onrender.com

# 🗃️ BANCO DE DADOS
# Para PostgreSQL (Render):
DATABASE_URL=postgresql://alma_user:password@oregon-postgres.render.com/almadb_63jp

# Para MySQL (Desenvolvimento):
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=almaDB
MYSQL_PORT=3306

# 🔐 SEGURANÇA JWT
JWT_SECRET=seu_jwt_secret_super_seguro_aqui
JWT_EMAIL_SECRET=seu_email_secret_diferente_aqui
JWT_EXPIRES=1h

# 📧 EMAIL (Opcional)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=seu-email@gmail.com
MAIL_PASS=sua-senha-de-app
SUPPORT_EMAIL=contato@institutoalma.org

# 🛡️ SEGURANÇA
BCRYPT_ROUNDS=12

# 🔴 REDIS (Opcional)
REDIS_HOST=localhost
REDIS_PORT=6379

# 📁 UPLOADS
UPLOAD_MAX_SIZE=10485760